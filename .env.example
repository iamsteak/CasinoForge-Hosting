# Supabase project settings (public values are safe to expose; the secret key is not).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_OWNER_EMAIL=you@example.com

# Railway project-scoped token and the single persistent Discord worker's identifiers.
# Keep every Railway value server-side in Vercel; never prefix these with NEXT_PUBLIC_.
RAILWAY_API_TOKEN=replace_me
RAILWAY_PROJECT_ID=replace_me
RAILWAY_SERVICE_ID=replace_me
RAILWAY_ENVIRONMENT_ID=replace_me
